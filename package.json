{
  "name": "sz-pi-auto-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "keywords": ["pi-package"],
  "pi": {
    "extensions": ["./dist/src/bridge.js"]
  },
  "engines": {
    "node": ">=22.19.0"
